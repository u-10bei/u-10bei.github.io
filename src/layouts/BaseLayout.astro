---
import { SITE } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  heading?: string;
  subheading?: string;
  meta?: string;
  background?: string;
  description?: string;
  /** "page" headings are centered; "post" headings are left-aligned. */
  variant?: 'page' | 'post';
}

const { title, heading, subheading, meta, background, description, variant = 'page' } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const plainDescription = (description ?? SITE.description).replace(/<br\s*\/?>/g, ' ');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(background ?? '/img/posts/04.jpg', Astro.site);
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about.html', label: 'About' },
  { href: '/category/', label: 'Category' },
  { href: '/reference.html', label: 'Reference' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={plainDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon_package_v0.16/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon_package_v0.16/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon_package_v0.16/favicon-16x16.png" />
    <link rel="manifest" href="/img/favicon_package_v0.16/site.webmanifest" />
    <link rel="mask-icon" href="/img/favicon_package_v0.16/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#2d89ef" />
    <meta name="theme-color" content="#f5f5f5" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={variant === 'post' ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:description" content={plainDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <nav class="site-nav">
      <div class="container nav-inner">
        <a class="brand" href="/">{SITE.title}</a>
        <ul class="nav-menu">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
    </nav>

    <header class="masthead" style={background ? `background-image: url('${background}')` : undefined}>
      <div class={`container narrow masthead-inner ${variant}`}>
        <h1>{heading ?? title ?? SITE.title}</h1>
        {subheading && <p class="subheading" set:html={subheading} />}
        {meta && <p class="meta">{meta}</p>}
      </div>
    </header>

    <main class="container narrow">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container narrow">
        <ul class="social">
          <li><a href={`mailto:${SITE.email}`} aria-label="Email">✉</a></li>
          <li>
            <a href={`https://github.com/${SITE.github}`} aria-label="GitHub">
              <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            </a>
          </li>
        </ul>
        <slot name="footer" />
        <p class="copyright">Copyright &copy; {SITE.author} {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>
