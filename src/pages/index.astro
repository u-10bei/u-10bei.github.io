---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import { SITE } from '../site';
import { getPosts } from '../lib/posts';
import { REPOSITORY_GROUPS } from '../data/repositories';

const posts = (await getPosts()).slice(0, 5);
---

<BaseLayout subheading={SITE.description} background="/img/bg-index.jpg">
  <p>I' m gonna enrich it little by little.<br />少しづつ充実させていきます。</p>

  <h2>Repositories</h2>
  {REPOSITORY_GROUPS.map((group) => (
    <section class:list={['repo-group', { archived: group.archived }]}>
      <h3>{group.title}{group.archived && <span class="badge">アーカイブ</span>}</h3>
      {group.archived && <p class="repo-note">{group.archived}</p>}
      <ul class="repo-list">
        {group.repositories.map((repo) => (
          <li>
            <a class="repo-name" href={`https://github.com/${SITE.github}/${repo.name}`}>{repo.name}</a>
            <p class="repo-description">{repo.description}</p>
            {(repo.app || repo.post) && (
              <p class="repo-links">
                {repo.app && <a href={repo.app}>アプリを開く</a>}
                {repo.post && <a href={repo.post}>紹介記事</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
  <hr />

  {posts.map((post) => <PostPreview post={post} />)}

  <div class="pager">
    <a class="btn next" href="/posts/">View All Posts &rarr;</a>
  </div>
</BaseLayout>
