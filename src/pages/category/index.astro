---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, postUrl } from '../../lib/posts';

const posts = await getPosts();
const categories = Map.groupBy(posts, (post) => post.data.category);
const description = 'My interests and concerns.<br>私の興味の中心';
---

<BaseLayout title="Post category" subheading={description} description={description} background="/img/bg-post.jpg">
  {[...categories].map(([category, items]) => (
    <section>
      <h3>{category}</h3>
      <ul>
        {items.map((post) => <li><a href={postUrl(post)}>{post.data.title}</a></li>)}
      </ul>
    </section>
  ))}
</BaseLayout>
