---
/**
 * Embeds a chart generated by scripts/build_charts.py.
 *  - Plotly charts are HTML fragments inlined into the page.
 *  - Folium maps are standalone pages under public/charts/, shown in an iframe.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props { name: string }
const { name } = Astro.props;

const fragments = import.meta.glob<string>('../generated/charts/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const fragment = fragments[`../generated/charts/${name}.html`];
const page = existsSync(join(process.cwd(), 'public', 'charts', `${name}.html`)) ? `/charts/${name}.html` : undefined;
---

<figure class="chart">
  {fragment && <script is:inline src="/charts/plotly.min.js"></script>}
  {fragment && <Fragment set:html={fragment} />}
  {!fragment && page && <iframe class="chart-frame" src={page} title={name} loading="lazy"></iframe>}
  {!fragment && !page && (
    <div class="chart-missing">グラフ「{name}」がまだ生成されていません（<code>npm run charts</code> を実行してください）。</div>
  )}
  <figcaption class="chart-note">このグラフは Python（Plotly / folium）でサイトのビルド時に生成しています。</figcaption>
</figure>
